PORT=5000
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (no trailing slashes)
CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# Bootstrap admin account - auto-created on server start if it doesn't exist yet
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Required by POST /api/auth/register-admin to create additional admin accounts
ADMIN_SECRET_CODE=replace_with_a_long_random_string
